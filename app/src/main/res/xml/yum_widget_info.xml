<?xml version="1.0" encoding="utf-8"?>
<!-- targetCellWidth/Height (Android 12+) make the widget land on a sensible 2x2 by default while
     still resizing up to the large 4x4 layout, which is what the three-pane view needs room for.
     maxResizeHeight is raised from 250dp so users can actually reach the large layout. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="450dp"
    android:maxResizeHeight="450dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:description="@string/widget_description"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
